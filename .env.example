SERVER_NAME=Karmi's Windrose
INVITE_CODE=karmi01
PASSWORD=
MAX_PLAYER_COUNT=10

# SEA, CIS, or EU. Leave empty to let the server pick.
USER_SELECTED_REGION=

# Invite-code / P2P mode is unreliable for same-network play: it negotiates
# a connection via ICE/STUN/TURN, which commonly fails for a client on the
# same LAN as the server (NAT hairpin) even though the invite code itself
# resolves fine. Direct connection (below) is the reliable choice for
# same-network play -- see README "Networking".
P2P_PROXY_ADDRESS=0.0.0.0
USE_DIRECT_CONNECTION=true

# Direct-connection port. Works on host networking (default) with no port
# mapping needed -- only switch NETWORK_MODE to bridge if you have another
# reason to. Forward this port on both TCP and UDP on your router if players
# outside your LAN should join over direct connection too.
DIRECT_CONNECTION_SERVER_PORT=28050

# host (default; required for invite-code/P2P mode, and works fine for
# direct connection too) or bridge (only if you need Docker's bridge
# networking specifically).
NETWORK_MODE=host

# Set after migrating a world in — see README "Migrating your save" section.
# Leave empty to let the server generate a fresh world.
WORLD_ISLAND_ID=

# Auto-restore from RocksDB_v2_Backups if the live world is missing or
# broken on launch. This is how a migrated/imported world actually gets
# promoted into the live save on first boot — keep it on. See README
# "Migrating your save".
AUTO_LOAD_LATEST_BACKUP_IF_HAS_BROKEN=true
